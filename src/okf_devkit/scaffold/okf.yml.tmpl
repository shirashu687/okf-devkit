# `okf init` の生成設定。初回はこのまま使えます。
# 引数なしでは docs に shared 層を作り、サイト名にディレクトリ名を使います。
# 複数層を新規作成する場合は `okf init --help` を参照してください。
# 既存設定の更新に `init --force` を使わないでください。
bundle_root: {bundle_root}
site_name: {site_name}

# 層と文書・変更パスの対応（上から最初に一致した層を使用）
layers:
{layers}
layer_dirs:
{layer_dirs}
layer_map:
{layer_map}

index:
  root_heading: {root_heading}
log:
  # 空の場合、sync は履歴を自動追記しません。
  layers: {log_layers}
  paths:
{log_paths}

# その他の設定はパッケージの既定値を使います。
# リストの上書きは全体を置換します。語彙を変更する場合は
# バンドル内の CONVENTIONS.md も合わせて更新してください。
